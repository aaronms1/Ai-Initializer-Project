@startuml
actor User
participant SearchModelsView
participant SearchModelsBridge
participant DownloadersService #LightBlue
participant SecurityApiTokenUtil
participant LLMLibraryUtil
participant LLMDownloader
participant SearchModels
participant BridgeAnnotationProcessor
participant BridgeRegistry

User -> SearchModelsView: SearchModelsView(searchQuery)
SearchModelsView -> SearchModelsBridge: SearchModelsBridge(DownloadAction)
SearchModelsBridge -> DownloadersService: download(DownloadAction, llmName)
DownloadersService -> BridgeRegistry: bridgeRegistry.getService("downloaders-service")
DownloadersService -> SecurityApiTokenUtil: getApiToken()
DownloadersService -> LLMLibraryUtil: downloadLLMJsonFile()
DownloadersService -> LLMDownloader: downloadLLM(llmName)
DownloadersService -> SearchModels: searchModels(llmName)
DownloadersService -> SearchModelsBridge: Flux<Object>
SearchModelsBridge -> SearchModelsView: Download response
SearchModelsView -> User: Download response

== Annotation Processing ==
BridgeAnnotationProcessor -> DownloadersService: Scan for @Bridge
BridgeAnnotationProcessor -> BridgeRegistry: Register DownloadersService
@enduml