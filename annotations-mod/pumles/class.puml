@startuml

package "org.dacss.projectinitai.annotations" {
    class Bridge {
        +String value()
    }

    class BridgeAnnotationProcessor {
        +boolean process(Set<? extends TypeElement> annotations, RoundEnvironment roundEnv)
        +static Set<String> getRegisteredServices()
    }

    class BridgeRegistry {
        -Map<String, Object> bridgeMap
        +BridgeRegistry(ApplicationContext context)
        +Object getService(String bridgeName)
        +Set<String> getRegisteredServices()
    }
}

package "org.dacss.projectinitai.services" {
    class DownloadersService {
        +DownloadersService()
        +Flux<Object> download(DownloadAction action, String llmName)
    }
}

package "frontend.bridges" {
    class SearchModelsBridge {
        +Observable<any> call(DownloadActions action)
    }

    class ConnectionFactory {
        +Observable<T> call(String bridgeName, String method, Object params, Method httpMethod)
        +Observable<T> rsocketCall(String route, Object data, boolean isStream)
    }
}

package "frontend.pages" {
    class SearchModelsView {
        +void fetchAndSetModels()
        +void handleDownload(String modelId)
    }
}

package "frontend.enums" {
    class DownloadActions {}
}

package "frontend.components" {
    class NotificationService {
        +void show(String message, String type)
    }
}

BridgeAnnotationProcessor --> Bridge
BridgeRegistry --> BridgeAnnotationProcessor
BridgeRegistry --> Bridge
DownloadersService --> Bridge
DownloadersService --> DownloadActions
DownloadersService --> SecurityApiTokenUtil
DownloadersService --> LLMLibraryUtil
DownloadersService --> LLMDownloader
DownloadersService --> SearchModels
SearchModelsBridge --> ConnectionFactory
SearchModelsView --> SearchModelsBridge
SearchModelsView --> DownloadActions
SearchModelsView --> NotificationService

@enduml